{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.6.0"
    },
    "pages/*.php": {
      "runtime": "vercel-php@0.6.0"
    },
    "includes/*.php": {
      "runtime": "vercel-php@0.6.0"
    },
    "database/*.php": {
      "runtime": "vercel-php@0.6.0"
    },
    "*.php": {
      "runtime": "vercel-php@0.6.0"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "APP_ENV": "production"
  },
  "build": {
    "env": {
      "APP_ENV": "production"
    }
  }
}
